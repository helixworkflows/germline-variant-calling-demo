/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

aws {
    // Use the standard AWS credential provider chain (environment variables,
    // shared credentials/config files, or the EC2 instance role) for private S3 data.
    region = System.getenv('AWS_REGION') ?: System.getenv('AWS_DEFAULT_REGION') ?: 'us-east-1'
    client.anonymous = false
}

process {
    executor = 'awsbatch'
}
