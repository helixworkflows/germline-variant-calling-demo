/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    AWS Batch configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    nextflow run main.nf -profile awsbatch
----------------------------------------------------------------------------------------
*/

workDir = 's3://helix-workflows/scratch/work'

params {
    outdir = 's3://helix-workflows/scratch/results'

    // Do not load nf-core institutional auto-detection after this explicit AWS setup.
    custom_config_base = null

    config_profile_name        = 'AWS Batch'
    config_profile_description = 'AWS Batch execution using s3://helix-workflows/scratch/'
}

process {
    executor = 'awsbatch'
    queue    = 'germline-variant-calling-queue'
}

aws {
    region           = 'us-east-1'
    client.anonymous = false

    batch {
        // Installed on Batch workers by the nextflow-batch-workers launch template.
        // Keeping it under /opt prevents the host mount from masking container files.
        cliPath = '/opt/nextflow/bin/aws'

        // Provides task containers with access to the pipeline's S3 inputs and work area.
        jobRole = 'arn:aws:iam::467517327055:role/NextflowBatchJobRole'
    }
}

executor {
    queueSize = 100
}
